        <dependency>
            <groupId>com.psi</groupId>
            <artifactId>psi-purchase</artifactId>
        </dependency>
        <dependency>
            <groupId>com.psi</groupId>
            <artifactId>psi-stock</artifactId>
        </dependency>
        <dependency>
            <groupId>com.psi</groupId>
            <artifactId>psi-finance</artifactId>
        </dependency>
        <dependency>
            <groupId>com.psi</groupId>
            <artifactId>psi-member</artifactId>
