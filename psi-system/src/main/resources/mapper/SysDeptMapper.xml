<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.psi.system.mapper.SysDeptMapper">

    <resultMap id="DeptWithShopResultMap" type="com.psi.system.dto.SysDeptDTO">
        <id column="id" property="id"/>
        <result column="dept_name" property="deptName"/>
        <result column="parent_id" property="parentId"/>
        <result column="parent_name" property="parentName"/>
        <result column="dept_code" property="deptCode"/>
        <result column="leader" property="leader"/>
        <result column="phone" property="phone"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="shop_id" property="shopId"/>
        <result column="shop_name" property="shopName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectDeptPageWithShop" resultMap="DeptWithShopResultMap">
        SELECT 
            d.id,
            d.dept_name,
            d.parent_id,
            p.dept_name AS parent_name,
            d.dept_code,
            d.leader,
            d.phone,
            d.sort_order,
            d.shop_id,
            s.shop_name,
            d.description,
            d.status,
            d.create_time
        FROM sys_dept d
        LEFT JOIN sys_dept p ON p.id = d.parent_id AND p.del_flag = 0
        LEFT JOIN shop_info s ON s.id = d.shop_id AND s.del_flag = 0
        WHERE d.del_flag = 0
        <if test="deptName != null and deptName != ''">
            AND d.dept_name LIKE CONCAT('%', #{deptName}, '%')
        </if>
        <if test="deptCode != null and deptCode != ''">
            AND d.dept_code LIKE CONCAT('%', #{deptCode}, '%')
        </if>
        <if test="parentId != null">
            AND d.parent_id = #{parentId}
        </if>
        <if test="shopId != null">
            AND d.shop_id = #{shopId}
        </if>
        <if test="status != null">
            AND d.status = #{status}
        </if>
        ORDER BY d.sort_order ASC, d.create_time DESC
    </select>

</mapper>